<script>
  // Click toggles a "pinned" terracotta color on individual dots.
  document.querySelectorAll("[data-logo-mark] .logo-dot").forEach((dot) => {
    dot.addEventListener("click", () => dot.classList.toggle("clicked"));
  });
</script>
