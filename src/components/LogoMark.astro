---
/**
 * LogoMark — the dataviz.ar mark as inline SVG (not an <img>), because its
 * dots are interactive: each .logo-dot turns terracotta on hover (CSS) and
 * toggles that color on click (script below).
 *
 * Geometry copied verbatim from the original index.html.
 */
interface Props {
  /** Rendered width/height in px (the viewBox stays 130×130). */
  size?: number;
}
const { size = 130 } = Astro.props;
---

<svg
  class="logo-mark" data-logo-mark
  width={size}
  height={size}
  role="img"
  aria-label="dataviz.ar"
  viewBox="0 0 130 130"
  fill="none"
  xmlns="http://www.w3.org/2000/svg"
>
