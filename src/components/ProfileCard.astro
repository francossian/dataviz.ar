---
/**
 * ProfileCard — photo, typed-out name, cycling roles, tagline, CTAs, socials.
 *
 * Text is rendered in the HTML at build time and the script only *animates*
 * it. The old page injected every string with JS, so crawlers, screen
 * readers and no-JS visitors saw an empty card. Here:
 *   - the <h1> carries the real name in a visually-hidden span, and the
 *     typewriter types into a separate aria-hidden span;
 *   - the roles lists (both languages) travel to the script as a
 *     data-attribute (JSON), so the script needs no hard-coded copy and
 *     can switch lists when the visitor toggles the language.
 */
import SocialLinks from "./SocialLinks.astro";
import { dictionaries, t } from "../i18n";

const name = "Franco Guiragossian";
const rolesByLang = {
  es: dictionaries.es["profile.roles"],
  en: dictionaries.en["profile.roles"],
};
const tagline = t("profile.roles").join(" · ");
---

<div class="hero-card">
  <div class="hero-content" data-profile-card data-roles={JSON.stringify(rolesByLang)}>
    <img
      src="/images/franco.webp"
      alt={name}
      class="hero-photo"
      width="140"
      height="140"
    />

    <h1 class="hero-name">
      <span class="sr-only">{name}</span>
      <span aria-hidden="true" data-typewriter={name}></span>
    </h1>

    <!-- Animated role line; the blinking cursor is pure CSS -->
    <p class="hero-role" aria-hidden="true">
      <span data-role></span><span class="cursor">|</span>
    </p>

    <!-- Fades in once the role animation starts (see .hero-tagline.is-visible) -->
    <p class="hero-tagline" data-tagline data-i18n="profile.roles">{tagline}</p>

    <div class="hero-ctas">
      <a href="/portfolio" class="btn btn-primary" data-i18n="profile.cta_portfolio"
        >{t("profile.cta_portfolio")}</a
      >
      <a href="/" class="btn btn-secondary" data-i18n="profile.cta_home"
        >{t("profile.cta_home")}</a
      >
    </div>

    <SocialLinks />
  </div>
</div>

<script>
  // Timing (ms) — same values as the original page
  const NAME_START_DELAY = 600; // wait before typing the name
  const NAME_CHAR_DELAY = 70; // per-character typing speed
  const ROLES_START_DELAY = 400; // pause between name done and roles start
  const TYPE_SPEED = 60;
  const DELETE_SPEED = 35;
  const HOLD_TIME = 1800; // how long a full role stays on screen

  document.querySelectorAll<HTMLElement>("[data-profile-card]").forEach((card) => {
    const nameEl = card.querySelector<HTMLElement>("[data-typewriter]")!;
    const roleEl = card.querySelector<HTMLElement>("[data-role]")!;
    const taglineEl = card.querySelector<HTMLElement>("[data-tagline]")!;
    const name = nameEl.dataset.typewriter ?? "";
    const rolesByLang: Record<string, string[]> = JSON.parse(card.dataset.roles ?? "{}");
    // <html lang> is kept current by BaseLayout's i18n script.
    const currentRoles = () => rolesByLang[document.documentElement.lang] ?? rolesByLang.es;

    // 1. Type the name one character at a time, then hand off to the roles.
    let i = 0;
    function typeName() {
      if (i <= name.length) {
        nameEl.textContent = name.slice(0, i);
        i++;
        setTimeout(typeName, NAME_CHAR_DELAY);
      } else {
        setTimeout(startRoleMorph, ROLES_START_DELAY);
      }
    }
    setTimeout(typeName, NAME_START_DELAY);

    // 2. Type a role, hold it, delete it, move to the next — forever.
    function startRoleMorph() {
      taglineEl.classList.add("is-visible");
      let roleIndex = 0,
        charIndex = 0,
        deleting = false;
      // The one pending step of the loop. Keeping its id lets a language
      // switch cancel it — otherwise a switch during HOLD_TIME would leave
      // the line blank until the hold ran out.
      let timer: ReturnType<typeof setTimeout>;

      // On a language switch, restart typing the SAME role (same index) in
      // the new language, right away. Cancelling first guarantees there is
      // still only ever one loop running.
      document.addEventListener("langchange", () => {
        clearTimeout(timer);
        charIndex = 0;
        deleting = false;
        roleEl.textContent = "";
        morph();
      });

      function morph() {
        const roles = currentRoles();
        const current = roles[roleIndex];
        if (!deleting) {
          roleEl.textContent = current.slice(0, charIndex + 1);
          charIndex++;
          if (charIndex === current.length) {
            deleting = true;
            timer = setTimeout(morph, HOLD_TIME);
            return;
          }
        } else {
          roleEl.textContent = current.slice(0, charIndex - 1);
          charIndex--;
          if (charIndex === 0) {
            deleting = false;
            roleIndex = (roleIndex + 1) % roles.length;
          }
        }
        timer = setTimeout(morph, deleting ? DELETE_SPEED : TYPE_SPEED);
      }
      morph();
    }
  });
</script>
