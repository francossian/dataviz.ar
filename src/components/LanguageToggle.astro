---
/**
 * ES / EN switch in the header. The current language is plain text; the
 * other one is a LINK to the same content in that language:
 *  - general page (home, portfolio, bio) → its other-language URL
 *    (/portfolio/ ↔ /en/portfolio/);
 *  - inside a blog → the post's translation if it has one, else the other
 *    blog.
 * Following it remembers the choice (localStorage), so the "also in
 * English / también en español" notice doesn't show again.
 */
import { BLOGS, blogUrl, langFromUrl, otherLang, type Lang } from "@/blogs";
import { useTranslations } from "@/i18n";
import { generalPageFromPath, pageUrl } from "@/utils/bilingual";

type Props = {
  /** Inside a blog: where the other language lives (e.g. a translation) */
  altLangUrl?: string;
};

const { altLangUrl } = Astro.props;
const lang = langFromUrl(Astro.url);
const t = useTranslations(lang);
const langs: Lang[] = ["es", "en"];
const option =
  "lang-option rounded-full px-2 py-0.5 text-xs font-medium tracking-wide";

const generalPage = generalPageFromPath(Astro.url.pathname);
const other = otherLang(lang);
const otherHref =
  generalPage !== undefined
    ? pageUrl(other, generalPage)
    : (altLangUrl ?? blogUrl(other));
---

<div
  role="group"
  class="border-border flex items-center rounded-full border p-0.5"
  aria-label={t.a11y.language}
>
  {
    langs.map(l =>
      l === lang ? (
        <span class={option} lang={l} data-lang-current aria-current="true">
          {l.toUpperCase()}
        </span>
      ) : (
        <a
          class={option}
          href={otherHref}
          lang={l}
          hreflang={l}
          data-lang-link={l}
          title={generalPage !== undefined ? undefined : BLOGS[l].title}
        >
          {l.toUpperCase()}
        </a>
      )
    )
  }
</div>

<script>
  import { LANG_STORAGE_KEY } from "@/utils/bilingual";

  // Event delegation on document: survives AstroPaper's client-side page
  // swaps (view transitions) without re-binding.
  document.addEventListener("click", event => {
    const link = (event.target as HTMLElement | null)?.closest<HTMLElement>(
      "[data-lang-link]"
    );
    if (!link?.dataset.langLink) return;
    try {
      localStorage.setItem(LANG_STORAGE_KEY, link.dataset.langLink);
    } catch {
      // private mode: the choice just isn't remembered
    }
  });
</script>
