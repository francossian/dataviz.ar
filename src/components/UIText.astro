---
/**
 * A piece of UI text in the page's language — the blog's, or the general
 * page's (/en/… = English, see src/utils/bilingual.ts).
 *
 * Text from the dictionaries:   <UIText get={t => t.nav.about} />
 * Page-specific text:           <UIText es="Hola" en="Hi" />
 */
import { langFromUrl } from "@/blogs";
import { useTranslations } from "@/i18n";
import type { UIStrings } from "@/i18n/types";

type Props = { get: (t: UIStrings) => string } | { es: string; en: string };

const props = Astro.props;
const lang = langFromUrl(Astro.url);
const text = "get" in props ? props.get(useTranslations(lang)) : props[lang];
---

{text}
