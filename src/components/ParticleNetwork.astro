---
/**
 * ParticleNetwork — animated node-link background drawn on a <canvas>.
 *
 * Why an .astro component with a <script> rather than a React island:
 * the animation is imperative canvas drawing with no UI state to re-render,
 * so React would add ~40 KB of runtime for nothing. Astro bundles this
 * <script> once per page as a small ES module, with zero framework JS.
 *
 * Place it inside a positioned container (e.g. `.hero`); the canvas
 * absolutely fills its parent (see `.particle-canvas` in global.css).
 */
---

<canvas class="particle-canvas" data-particle-canvas aria-hidden="true"></canvas>

<script>
  // Astro hoists and bundles this script; it runs once per page even if the
  // component is used several times — so it finds every canvas itself
  // (via the data attribute) instead of relying on a single element id.
  const COUNT = 60; // number of nodes
  const LINK_DIST = 130; // max distance (px) at which two nodes get a link
  const SPEED = 0.4; // base drift speed (px per frame)
  const NODE_COLOR = "rgba(117, 170, 219, 0.6)"; // --color-sky-400 at 60%

  function initParticles(canvas: HTMLCanvasElement) {
    const ctx = canvas.getContext("2d");
    if (!ctx) return;

    // The canvas bitmap size must match its CSS box, otherwise drawing is
    // stretched/blurry. Re-sync whenever the window resizes.
    function resize() {
      canvas.width = canvas.offsetWidth;
      canvas.height = canvas.offsetHeight;
    }
    resize();
    window.addEventListener("resize", resize);

    // Mouse position in canvas coordinates; parked far off-screen when the
    // pointer leaves so it stops attracting nodes.
    let mouse = { x: -999, y: -999 };
    canvas.addEventListener("mousemove", (e) => {
      const rect = canvas.getBoundingClientRect();
      mouse.x = e.clientX - rect.left;
      mouse.y = e.clientY - rect.top;
    });
    canvas.addEventListener("mouseleave", () => {
      mouse = { x: -999, y: -999 };
    });

    const nodes = Array.from({ length: COUNT }, () => ({
      x: Math.random() * canvas.width,
      y: Math.random() * canvas.height,
      vx: (Math.random() - 0.5) * SPEED,
      vy: (Math.random() - 0.5) * SPEED,
      r: Math.random() * 2 + 1.5,
    }));

    function tick() {
      ctx!.clearRect(0, 0, canvas.width, canvas.height);

      // 1. Move nodes: gentle pull towards the mouse, capped speed,
      //    bounce off the edges.
      for (const n of nodes) {
        const dx = mouse.x - n.x,
          dy = mouse.y - n.y;
        const dist = Math.sqrt(dx * dx + dy * dy);
        if (dist < 120) {
          n.vx += (dx / dist) * 0.03;
          n.vy += (dy / dist) * 0.03;
        }
        const speed = Math.sqrt(n.vx * n.vx + n.vy * n.vy);
        if (speed > SPEED * 3) {
          n.vx = (n.vx / speed) * SPEED * 3;
          n.vy = (n.vy / speed) * SPEED * 3;
        }
        n.x += n.vx;
        n.y += n.vy;
        if (n.x < 0 || n.x > canvas.width) n.vx *= -1;
        if (n.y < 0 || n.y > canvas.height) n.vy *= -1;
      }

      // 2. Links: closer pairs get a more opaque line (fades out at LINK_DIST).
      for (let i = 0; i < nodes.length; i++) {
        for (let j = i + 1; j < nodes.length; j++) {
          const dx = nodes[i].x - nodes[j].x,
            dy = nodes[i].y - nodes[j].y;
          const d = Math.sqrt(dx * dx + dy * dy);
          if (d < LINK_DIST) {
            ctx!.strokeStyle = `rgba(117, 170, 219, ${(1 - d / LINK_DIST) * 0.4})`;
            ctx!.lineWidth = 1;
            ctx!.beginPath();
            ctx!.moveTo(nodes[i].x, nodes[i].y);
            ctx!.lineTo(nodes[j].x, nodes[j].y);
            ctx!.stroke();
          }
        }
      }

      // 3. Nodes drawn last so they sit on top of the links.
      for (const n of nodes) {
        ctx!.beginPath();
        ctx!.arc(n.x, n.y, n.r, 0, Math.PI * 2);
        ctx!.fillStyle = NODE_COLOR;
        ctx!.fill();
      }
      requestAnimationFrame(tick);
    }
    tick();
  }

  document
    .querySelectorAll<HTMLCanvasElement>("[data-particle-canvas]")
    .forEach(initParticles);
</script>
