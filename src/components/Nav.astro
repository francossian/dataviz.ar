---
/**
 * Site nav — fixed bar, three-column grid (wordmark · logo · links).
 *
 * The "active" link used to be hard-coded per HTML file. Now it's derived
 * from the current URL, so there's one nav definition for every page.
 * Labels are i18n keys: rendered in Spanish at build time, swapped
 * client-side via data-i18n (see BaseLayout).
 */
import LanguageToggle from "./LanguageToggle.astro";
import { t, type I18nKey } from "../i18n";

const links: { href: string; key: I18nKey }[] = [
  { href: "/", key: "nav.home" },
  { href: "/franco-guiragossian", key: "nav.about" },
  { href: "/portfolio", key: "nav.portfolio" },
];

// Strip a trailing slash so "/portfolio/" and "/portfolio" compare equal.
const path = Astro.url.pathname.replace(/\/$/, "") || "/";
// Home matches exactly; other links also match their sub-pages
// (e.g. /portfolio/something keeps "Portfolio" highlighted).
const isActive = (href: string) =>
  href === "/" ? path === "/" : path === href || path.startsWith(`${href}/`);
---

<header class="site-nav">
  <a href="/" class="nav-logo">dataviz.ar</a>
  <a href="/" class="nav-center-logo" aria-label="dataviz.ar home">
    <img src="/images/logo/logo-white.svg" alt="dataviz.ar logo" height="38" />
  </a>
  <nav>
    <ul class="nav-links">
      {
        links.map(({ href, key }) => (
          <li>
            <a
              href={href}
              class:list={["nav-link", { active: isActive(href) }]}
              aria-current={isActive(href) ? "page" : undefined}
              data-i18n={key}
            >
              {t(key)}
            </a>
          </li>
        ))
      }
    </ul>
    <LanguageToggle />
  </nav>
</header>
