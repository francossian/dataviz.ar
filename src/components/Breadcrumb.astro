---
/**
 * Breadcrumb trail built from the URL, aware of the two blogs:
 *   /datos-y-relatos/tags/encuestas/2/
 *   → Inicio » Datos y relatos » Etiquetas » encuestas (página 2)
 * Labels come from the page's language (Spanish or English blog).
 */
import { stripBase } from "@/utils/withBase";
import { blogFromPath, langFromUrl } from "@/blogs";
import { useTranslations } from "@/i18n";
import UIText from "./UIText.astro";

const t = useTranslations(langFromUrl(Astro.url));

const decodeSegment = (value: string) => {
  try {
    return decodeURIComponent(value);
  } catch {
    return value;
  }
};

type Crumb = { label: string; href: string };

const path = stripBase(Astro.url.pathname);
const segments = path.split("/").filter(Boolean);
const blog = blogFromPath(path);

const sectionLabels: Record<string, string> = {
  tags: t.nav.tags,
  archives: t.nav.archives,
  search: t.nav.search,
};

// Walk the path, accumulating each crumb's own URL. A trailing page number
// (pagination) isn't a crumb: it's appended to the previous label instead.
const crumbs: Crumb[] = [];
let href = "/";
for (const [index, segment] of segments.entries()) {
  href += `${segment}/`;
  const isPageNumber = /^\d+$/.test(segment) && index === segments.length - 1;
  if (isPageNumber && crumbs.length > 0) {
    if (segment !== "1") {
      crumbs[crumbs.length - 1].label +=
        ` (${t.pagination.page.toLowerCase()} ${segment})`;
    }
    continue;
  }
  const label =
    index === 0 && blog
      ? blog.title // the blog's proper name, not its URL slug
      : (sectionLabels[segment] ?? decodeSegment(segment));
  crumbs.push({ label, href });
}
---

<nav class="app-layout mt-8 mb-1" aria-label="breadcrumb">
  <ul
    class="flex flex-wrap items-center gap-x-1 font-light [&>li:not(:last-child)>a]:hover:opacity-100"
  >
    <li class="flex items-center gap-x-1">
      <a href="/" class="opacity-80"><UIText get={t => t.nav.home} /></a>
      <span aria-hidden="true" class="opacity-80">&raquo;</span>
    </li>
    {
      crumbs.map(({ label, href }, index) =>
        index + 1 === crumbs.length ? (
          <li>
            <span class="opacity-75" aria-current="page">
              {label}
            </span>
          </li>
        ) : (
          <li class="flex items-center gap-x-1">
            <a href={href} class="opacity-70">
              {label}
            </a>
            <span aria-hidden="true" class="opacity-70">
              &raquo;
            </span>
          </li>
        )
      )
    }
  </ul>
</nav>
