---
import IconCalendar from "@/assets/icons/IconCalendar.svg";
import config from "@/config";
import { useTranslations } from "@/i18n";
import { langFromUrl } from "@/blogs";

type Props = {
  class?: string;
  size?: "sm" | "lg";
  pubDatetime: string | Date;
  timezone?: string;
  modDatetime?: string | Date | null;
};

const {
  pubDatetime,
  modDatetime,
  size = "sm",
  class: className = "",
  timezone: postTimezone,
} = Astro.props;

const lang = langFromUrl(Astro.url);
const t = useTranslations(lang);

const isModified = modDatetime && modDatetime > pubDatetime;

const datetime = new Date(isModified ? modDatetime : pubDatetime);

// Month names in the page's language (dayjs, used before, only had English).
// Intl gives the parts; we assemble them so Spanish reads "3 oct 2026"
// instead of es-AR's default "3 de oct. de 2026". English: "Oct 3, 2026".
const formatter = new Intl.DateTimeFormat(lang === "es" ? "es-AR" : "en-US", {
  day: "numeric",
  month: "short",
  year: "numeric",
  timeZone: postTimezone ?? config.site.timezone,
});
const part = (type: Intl.DateTimeFormatPartTypes) =>
  formatter.formatToParts(datetime).find(p => p.type === type)?.value ?? "";

const date =
  lang === "es"
    ? `${part("day")} ${part("month").replace(/\.$/, "")} ${part("year")}`
    : formatter.format(datetime);
---

<div
  class:list={["text-muted-foreground flex items-center gap-x-2", className]}
>
  <IconCalendar
    class:list={[
      "inline-block size-6 min-w-5.5",
      { "scale-90": size === "sm" },
    ]}
  />
  {
    isModified && (
      <span class:list={["text-sm", { "sm:text-base": size === "lg" }]}>
        {t.post.updatedAt}:
      </span>
    )
  }
  <time
    class:list={["text-sm", { "sm:text-base": size === "lg" }]}
    datetime={datetime.toISOString()}
  >
    {date}
  </time>
</div>
