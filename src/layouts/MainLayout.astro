---
/**
 * MainLayout — BaseLayout + site chrome (nav and footer).
 *
 * Composition instead of a `showChrome` boolean: pages that want chrome use
 * this; a page that must be bare uses BaseLayout directly.
 */
import BaseLayout from "./BaseLayout.astro";
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";

// Forward everything (title, description) straight through to BaseLayout.
type Props = import("./BaseLayout.astro").Props;
const props = Astro.props;
---

<BaseLayout {...props}>
  <slot name="head" slot="head" />
  <Nav />
  <main>
    <slot />
  </main>
  <Footer />
</BaseLayout>
