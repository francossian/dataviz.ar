---
import { Font } from "astro:assets";
import { ClientRouter } from "astro:transitions";
import { blogUrl, langFromUrl } from "@/blogs";
import { resolveDefaultOgImagePath } from "@/utils/resolveDefaultOgImagePath";
import { getAssetPath } from "@/utils/withBase";
import { isBilingualPage, LANG_STORAGE_KEY } from "@/utils/bilingual";
import Analytics from "@/components/Analytics.astro";
import config from "@/config";
import "@/styles/global.css";

type Props = {
  title?: string;
  description?: string;
  ogImage?: string;
  canonicalURL?: string;
};

const { site } = config;

const {
  title = site.title,
  description = site.description,
  ogImage = resolveDefaultOgImagePath(config),
  canonicalURL = new URL(Astro.url.pathname, Astro.site).href,
} = Astro.props;

const socialImageURL = new URL(ogImage, Astro.site ?? Astro.url);
// Pages inside a blog are in its language; the rest use the default (es)
const lang = langFromUrl(Astro.url);
// RSS autodiscovery: the current blog's feed (Datos y relatos elsewhere)
const rssHref = blogUrl(lang, "rss.xml");
// General pages carry both languages; the head script picks one
const bilingual = isBilingualPage(Astro.url);
---

<!doctype html>
<html
  dir={site.dir ?? "ltr"}
  lang={lang}
  data-bilingual={bilingual ? "true" : undefined}
  class="overflow-y-scroll scroll-smooth"
>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href={getAssetPath("favicon.svg")} />
    <link rel="canonical" href={canonicalURL} />
    <meta name="generator" content={Astro.generator} />

    <!-- Fonts: DM Sans (body) and Jost (headings), self-hosted by Astro.
         Preload only the weights visible above the fold on every page. -->
    <Font
      cssVariable="--font-dm-sans"
      preload={[{ subset: "latin", weight: 400, style: "normal" }]}
    />
    <Font
      cssVariable="--font-jost"
      preload={[{ subset: "latin", weight: 600, style: "normal" }]}
    />

    <!-- Primary meta -->
    <title>{title}</title>
    <meta name="title" content={title} />
    <meta name="description" content={description} />
    <meta name="author" content={site.author} />
    <link rel="sitemap" href={getAssetPath("sitemap-index.xml")} />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.title} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:image" content={socialImageURL} />

    <!-- Twitter / X -->
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content={canonicalURL} />
    <meta property="twitter:title" content={title} />
    <meta property="twitter:description" content={description} />
    <meta property="twitter:image" content={socialImageURL} />

    <!-- RSS autodiscovery -->
    <link
      rel="alternate"
      type="application/rss+xml"
      title={site.title}
      href={new URL(rssHref, Astro.site)}
    />

    <!-- Filled at runtime by theme.ts to match the current background colour -->
    <meta name="theme-color" content="" />

    <!-- Extra head content injected by child layouts (e.g. JSON-LD, article meta) -->
    <slot name="head" />

    {
      site.googleVerification && (
        <meta
          name="google-site-verification"
          content={site.googleVerification}
        />
      )
    }

    <!--
      Inline FOUC-prevention script: sets data-theme on <html> before
      the browser paints. Runs synchronously, no defer/async.
    -->
    <script is:inline>
      (function () {
        // Light is the site's default look; dark only if the visitor chose
        // it with the theme button (the OS preference is deliberately
        // ignored). localStorage can throw in private mode → fall back.
        let stored = null;
        try {
          stored = localStorage.getItem("theme");
        } catch (e) {}
        const theme = stored === "dark" ? "dark" : "light";
        const root = document.firstElementChild;
        root?.setAttribute("data-theme", theme);
        root?.classList.toggle("dark", theme === "dark");
        // Expose value so theme.ts can skip re-detection.
        window.__theme = { value: theme };
      })();
    </script>

    {
      /*
      Language: same idea as the theme script above — runs synchronously in
      <head>, so <html lang> is final before the first paint and the CSS in
      global.css shows only that language (no flash of the other one).
      Only general pages (data-bilingual) switch; blog pages keep their
      blog's language. See src/utils/bilingual.ts.
    */
    }
    <script is:inline define:vars={{ KEY: LANG_STORAGE_KEY }}>
      // The visitor's explicit choice wins; otherwise their browser's
      // main language: anything starting with "es" → Spanish, else English.
      function preferredLang() {
        let stored = null;
        try {
          stored = localStorage.getItem(KEY);
        } catch (e) {}
        if (stored === "es" || stored === "en") return stored;
        const nav =
          (navigator.languages && navigator.languages[0]) ||
          navigator.language ||
          "";
        return nav.toLowerCase().startsWith("es") ? "es" : "en";
      }

      const isBilingual = doc =>
        doc.documentElement.dataset.bilingual === "true";

      // Attributes can't be rendered twice: apply the one for this language
      function applyAttrs(lang) {
        document.querySelectorAll("[data-i18n-attrs]").forEach(el => {
          try {
            const attrs = JSON.parse(el.getAttribute("data-i18n-attrs"));
            for (const name in attrs) el.setAttribute(name, attrs[name][lang]);
          } catch (e) {}
        });
        document.querySelectorAll("[data-lang-btn]").forEach(btn => {
          btn.setAttribute(
            "aria-pressed",
            String(btn.dataset.langBtn === lang)
          );
        });
      }

      if (isBilingual(document)) {
        document.documentElement.lang = preferredLang();
      }
      document.addEventListener("DOMContentLoaded", () => {
        if (isBilingual(document)) applyAttrs(document.documentElement.lang);
      });

      // AstroPaper swaps pages client-side (view transitions): set the
      // language on the incoming page before it's shown, then its attributes.
      document.addEventListener("astro:before-swap", event => {
        if (isBilingual(event.newDocument)) {
          event.newDocument.documentElement.lang = preferredLang();
        }
      });
      document.addEventListener("astro:after-swap", () => {
        if (isBilingual(document)) applyAttrs(document.documentElement.lang);
      });

      // Called by LanguageToggle: remember the choice and, on a general
      // page, switch right away.
      window.__setSiteLang = lang => {
        try {
          localStorage.setItem(KEY, lang);
        } catch (e) {}
        if (isBilingual(document)) {
          document.documentElement.lang = lang;
          applyAttrs(lang);
        }
      };
    </script>

    <!-- Google Analytics via Partytown (only with a real ID, in production) -->
    <Analytics />

    <ClientRouter />
  </head>
  <body
    class="bg-background font-app text-foreground selection:bg-decor/60 selection:text-foreground flex min-h-svh flex-col"
  >
    <slot />
    <script>
      import "@/scripts/theme";
    </script>
  </body>
</html>
