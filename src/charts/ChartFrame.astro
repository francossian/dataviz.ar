---
/**
 * The frame every chart shares: the #EEEEEE panel with the plot (default
 * slot) and, at the bottom, the source + signature.
 *
 * The plot itself is hidden from screen readers; instead they get `table`,
 * the same data as an accessible table.
 */
import ChartSignature from "./ChartSignature.astro";
import type { Lang } from "@/blogs";

type Props = {
  /** Stable slug: seeds the signature's fingerprint */
  id: string;
  /** Data source — always attribute it (CLAUDE.md) */
  source?: string;
  /** Optional second footer line under the source, e.g. "Elaborado por …" */
  note?: string;
  lang: Lang;
  /** Same data, for screen readers */
  table: { headers: string[]; rows: string[][] };
};

const { id, source, note, lang, table } = Astro.props;
const sourceLabel = lang === "es" ? "Fuente" : "Source";
---

{/* not-prose: inside blog posts, keep Tailwind Typography's styles off */}
<figure class="chart not-prose" lang={lang}>
  <div class="chart-plot-area" aria-hidden="true">
    <slot />
  </div>

  <table class="sr-only">
    <thead>
      <tr>{table.headers.map(h => <th scope="col">{h}</th>)}</tr>
    </thead>
    <tbody>
      {
        table.rows.map(row => (
          <tr>
            {row.map(cell => (
              <td>{cell}</td>
            ))}
          </tr>
        ))
      }
    </tbody>
  </table>

  {
    /* Footer: left, the source and an optional second line (two lines
      max); right, the signature */
  }
  <div class="chart-footer">
    <div class="chart-credits">
      {source && <span>{`${sourceLabel}: ${source}`}</span>}
      {note && <span>{note}</span>}
    </div>
    <ChartSignature {id} />
  </div>
</figure>
