---
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Breadcrumb from "@/components/Breadcrumb.astro";
import Main from "@/components/Main.astro";
import Footer from "@/components/Footer.astro";
import Tag from "@/components/Tag.astro";
import { getUniqueTags } from "@/utils/getUniqueTags";
import { getBlogPosts } from "@/utils/getBlogPosts";
import { BLOG_LIST, type Blog } from "@/blogs";
import { useTranslations } from "@/i18n";
import config from "@/config";

export function getStaticPaths() {
  return BLOG_LIST.map(blog => ({
    params: { blog: blog.slug },
    props: { blog },
  }));
}

const { blog } = Astro.props as { blog: Blog };
const tags = getUniqueTags(await getBlogPosts(blog.lang));
const t = useTranslations(blog.lang);
---

<Layout title={`${t.pages.tagsTitle} · ${blog.title} | ${config.site.title}`}>
  <Header />

  <Breadcrumb />

  <Main pageTitle={t.pages.tagsTitle} pageDesc={t.pages.tagsDesc}>
    <ul class="flex flex-wrap gap-6">
      {tags.map(({ tag, tagName }) => <Tag {tag} {tagName} />)}
    </ul>
  </Main>

  <Footer />
</Layout>
