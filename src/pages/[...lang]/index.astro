---
/**
 * Home: a short intro, the latest posts and a pointer to the portfolio.
 * Deliberately no hero or calls to action — the site shows work, it
 * doesn't sell.
 *
 * Built twice: / (Spanish, latest from Datos y relatos) and /en/
 * (English, latest from Data Stories) — see src/utils/bilingual.ts.
 */
import IconRss from "@/assets/icons/IconRss.svg";
import IconArrowRight from "@/assets/icons/IconArrowRight.svg";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import Card from "@/components/Card.astro";
import LinkButton from "@/components/LinkButton.astro";
import UIText from "@/components/UIText.astro";
import { getBlogPosts } from "@/utils/getBlogPosts";
import { BLOGS, blogUrl, langFromUrl } from "@/blogs";
import { useTranslations } from "@/i18n";
import { generalPagePaths, pageUrl } from "@/utils/bilingual";
import config from "@/config";

export const getStaticPaths = generalPagePaths;

const lang = langFromUrl(Astro.url);
const homePath = pageUrl(lang, "");

// The latest posts of the blog in this page's language
const blog = BLOGS[lang];
const t = useTranslations(lang);
const posts = (await getBlogPosts(lang)).slice(0, config.posts.perIndex);
---

<Layout
  description={lang === "es"
    ? "Franco Guiragossian: análisis y visualización de datos."
    : "Franco Guiragossian: data analysis and visualization."}
>
  <Header />
  <main
    id="main-content"
    data-layout="index"
    data-home-path={homePath}
    class="app-layout my-1"
  >
    <section id="hero" class="border-border border-b pt-8 pb-6">
      <h1 class="my-4 inline-block text-3xl font-semibold sm:my-6 sm:text-4xl">
        <UIText es="Hola, soy Franco." en="Hi, I'm Franco." />
      </h1>

      <p class="text-lg leading-relaxed sm:text-xl">
        <UIText
          es="Trabajo con datos: diseño encuestas, armo dashboards y hago visualizaciones. Acá publico lo que voy haciendo y lo que aprendo en el camino."
          en="I work with data: I design surveys, build dashboards and make visualizations. Here I publish what I'm working on and what I learn along the way."
        />
      </p>
    </section>

    <section id="recent-posts" class="pt-12 pb-6">
      <h2 class="flex items-center gap-3 text-2xl font-semibold tracking-wide">
        {t.home.recentPosts}
        <a
          href={blogUrl(blog.lang, "rss.xml")}
          class="inline-block"
          title={`RSS — ${blog.title}`}
        >
          <IconRss
            width={20}
            height={20}
            class="stroke-accent scale-110 stroke-3 rtl:-rotate-90"
          />
          <span class="sr-only">{`RSS — ${blog.title}`}</span>
        </a>
      </h2>

      {
        posts.length > 0 ? (
          <ul>
            {posts.map(data => (
              <Card variant="h3" {...data} />
            ))}
          </ul>
        ) : (
          <p class="text-muted-foreground mt-4">{t.blog.empty}</p>
        )
      }

      <div class="my-8 text-center">
        <LinkButton href={blogUrl(blog.lang)}>
          {blog.title}
          <IconArrowRight class="inline-block rtl:-rotate-180" />
        </LinkButton>
      </div>
    </section>

    <section id="portfolio" class="border-border border-t pt-10 pb-6">
      <p>
        <UIText
          es="Simulaciones, exploradores e infografías interactivas:"
          en="Simulations, explorers and interactive infographics:"
        />{" "}
        <a
          href={pageUrl(lang, "portfolio")}
          class="text-accent decoration-decor hover:text-highlight hover:decoration-highlight font-medium underline decoration-2 underline-offset-3"
        >
          <UIText es="ver portfolio" en="see portfolio" /> →
        </a>
      </p>
    </section>
  </main>
  <Footer />
</Layout>

<script>
  document.addEventListener("astro:page-load", () => {
    const indexLayout = (document.querySelector("#main-content") as HTMLElement)
      ?.dataset;
    const baseRoot = import.meta.env.BASE_URL.replace(/\/?$/, "/");
    if (indexLayout?.layout) {
      sessionStorage.setItem("backUrl", indexLayout.homePath ?? baseRoot);
    }
  });
</script>
