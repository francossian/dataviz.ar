---
import { getRelativeLocaleUrl } from "astro:i18n";
import IconRss from "@/assets/icons/IconRss.svg";
import IconArrowRight from "@/assets/icons/IconArrowRight.svg";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import Card from "@/components/Card.astro";
import LinkButton from "@/components/LinkButton.astro";
import { getBlogPosts } from "@/utils/getBlogPosts";
import { BLOGS, DEFAULT_LANG, blogUrl } from "@/blogs";
import { useTranslations } from "@/i18n";
import config from "@/config";

const { posts: postsConfig } = config;

const locale = config.site.lang;
const t = useTranslations(DEFAULT_LANG);

// Latest posts from the blog in the page's language. Built in Spanish for
// now; the ES/EN toggle (next step) will switch to Data Stories for
// English visitors.
const blog = BLOGS[DEFAULT_LANG];
const sortedPosts = await getBlogPosts(blog.lang);
const featuredPosts = sortedPosts.filter(({ data }) => data.featured);
const recentPosts = sortedPosts.filter(({ data }) => !data.featured);
const homePath = getRelativeLocaleUrl(locale, "");
---

<Layout>
  <Header />
  <main
    id="main-content"
    data-layout="index"
    data-home-path={homePath}
    class="app-layout my-1"
  >
    <section id="hero" class="border-border border-b pt-8 pb-6">
      <!-- Intro: who I am and what this is. Deliberately no buttons or
           calls to action — the site shows work, it doesn't sell. -->
      <h1 class="my-4 inline-block text-3xl font-semibold sm:my-6 sm:text-4xl">
        Hola, soy Franco.
      </h1>
      <a
        target="_blank"
        href={blogUrl(blog.lang, "rss.xml")}
        class="ms-2 inline-block"
        aria-label="RSS Feed"
        title="RSS Feed"
      >
        <IconRss
          width={20}
          height={20}
          class="stroke-accent scale-125 stroke-3 rtl:-rotate-90"
        />
        <span class="sr-only">RSS Feed</span>
      </a>

      <p class="text-lg leading-relaxed sm:text-xl">
        Trabajo con datos: diseño encuestas, armo dashboards y hago
        visualizaciones. Acá publico lo que voy haciendo y lo que aprendo en el
        camino.
      </p>
    </section>

    {
      featuredPosts.length > 0 && (
        <section
          id="featured"
          class:list={[
            "pt-12 pb-6",
            { "border-border border-b": recentPosts.length > 0 },
          ]}
        >
          <h2 class="text-2xl font-semibold tracking-wide">
            {t.home.featured}
          </h2>
          <ul>
            {featuredPosts.map(data => (
              <Card variant="h3" {...data} />
            ))}
          </ul>
        </section>
      )
    }

    {
      recentPosts.length > 0 && (
        <section id="recent-posts" class="pt-12 pb-6">
          <h2 class="text-2xl font-semibold tracking-wide">
            {t.home.recentPosts}
          </h2>
          <ul>
            {recentPosts.slice(0, postsConfig.perIndex).map(data => (
              <Card variant="h3" {...data} />
            ))}
          </ul>
        </section>
      )
    }

    {
      sortedPosts.length === 0 && (
        <section id="recent-posts" class="pt-12 pb-6">
          <h2 class="text-2xl font-semibold tracking-wide">
            {t.home.recentPosts}
          </h2>
          <p class="text-muted-foreground mt-4">{t.blog.empty}</p>
        </section>
      )
    }

    <div class="my-8 text-center">
      <LinkButton href={blogUrl(blog.lang)}>
        {blog.title}
        <IconArrowRight class="inline-block rtl:-rotate-180" />
      </LinkButton>
    </div>
  </main>
  <Footer />
</Layout>

<script>
  document.addEventListener("astro:page-load", () => {
    const indexLayout = (document.querySelector("#main-content") as HTMLElement)
      ?.dataset;
    const baseRoot = import.meta.env.BASE_URL.replace(/\/?$/, "/");
    if (indexLayout?.layout) {
      sessionStorage.setItem("backUrl", indexLayout.homePath ?? baseRoot);
    }
  });
</script>
