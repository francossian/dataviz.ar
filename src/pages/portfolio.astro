---
/**
 * Portfolio: interactive projects (each on its own subdomain) and a
 * gallery of static visualizations. Bilingual page — headings follow the
 * ES/EN switch; project texts show both languages (see ProjectItem).
 */
import { getCollection } from "astro:content";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import UIText from "@/components/UIText.astro";
import ProjectItem from "@/components/ProjectItem.astro";
import VizGallery from "@/components/VizGallery.astro";
import config from "@/config";

const projects = (await getCollection("portfolio")).sort(
  (a, b) => a.data.order - b.data.order
);

// Small, quiet section labels (the page title carries the weight)
const sectionLabel =
  "font-app text-muted-foreground mt-14 mb-6 text-sm font-bold tracking-widest uppercase";
---

<Layout
  title={`Portfolio | ${config.site.title}`}
  description="Proyectos interactivos y visualizaciones de Franco Guiragossian."
>
  <Header />
  <main id="main-content" class="app-layout pb-12">
    <h1 class="mt-10 text-3xl font-semibold sm:text-4xl">Portfolio</h1>
    <p class="text-muted-foreground mt-3 text-lg">
      <UIText
        es="Proyectos interactivos y visualizaciones. Cada proyecto vive en su propio sitio."
        en="Interactive projects and visualizations. Each project lives on its own site."
      />
    </p>

    <h2 class={sectionLabel}>
      <UIText es="Proyectos interactivos" en="Interactive projects" />
    </h2>
    <div class="grid gap-x-8 gap-y-14 sm:grid-cols-2">
      {projects.map(project => <ProjectItem {project} />)}
    </div>

    <h2 class={sectionLabel}>
      <UIText es="Visualizaciones" en="Visualizations" />
    </h2>
    <VizGallery />
  </main>
  <Footer />
</Layout>
